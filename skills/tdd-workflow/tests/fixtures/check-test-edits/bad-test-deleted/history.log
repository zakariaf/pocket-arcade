+// packages/game-kit/src/levels/stars-for-moves.test.ts
+import { starsForMoves } from './stars-for-moves.ts';
+
+describe('starsForMoves', () => {
+  it('gives 3 stars at par (spec 8.1)', () => {
+    expect(starsForMoves(7, 7)).toBe(3);
+  });
