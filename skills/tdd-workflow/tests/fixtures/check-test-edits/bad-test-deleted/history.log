@@ -0,0 +1,7 @@
+// packages/game-kit/src/levels/stars-for-moves.ts
+export function starsForMoves(moves: number, par: number): number {
+  if (moves <= par) {
+    return 3;
+  }
+  return moves <= par + 2 ? 2 : 1;
+}
