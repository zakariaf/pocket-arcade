==> commit 5d64fbf0596d851ef2d71727aa65eb455816eadd
feat(game-kit): give stars for moves against par

Spec 8.1: 3 stars at or under par, 2 at par + 2, 1 for finishing.

==> diff

diff --git a/packages/game-kit/src/levels/stars-for-moves.test.ts b/packages/game-kit/src/levels/stars-for-moves.test.ts
new file mode 100644
index 0000000..2d10f9a
--- /dev/null
+++ b/packages/game-kit/src/levels/stars-for-moves.test.ts
@@ -0,0 +1,12 @@
+// packages/game-kit/src/levels/stars-for-moves.test.ts
+import { starsForMoves } from './stars-for-moves.ts';
+
+describe('starsForMoves', () => {
+  it('gives 3 stars at par (spec 8.1)', () => {
+    expect(starsForMoves(7, 7)).toBe(3);
+  });
+
+  it('gives 2 stars at par + 2', () => {
+    expect(starsForMoves(9, 7)).toBe(2);
+  });
+});
diff --git a/packages/game-kit/src/levels/stars-for-moves.ts b/packages/game-kit/src/levels/stars-for-moves.ts
new file mode 100644
index 0000000..9c1c7da
--- /dev/null
+++ b/packages/game-kit/src/levels/stars-for-moves.ts
@@ -0,0 +1,7 @@
+// packages/game-kit/src/levels/stars-for-moves.ts
+export function starsForMoves(moves: number, par: number): number {
+  if (moves <= par) {
+    return 3;
+  }
+  return moves <= par + 2 ? 2 : 1;
+}
