+// packages/shell/src/game-host/draw-centered-text.ts
+export type Box = { readonly x: number; readonly y: number; readonly width: number; readonly height: number };
+
+/**
+ * The point a label is centered on.
+ * The shape the text must fit (a monster, a tile or a tray slot) is its box;
+ * xit (an old name) is not a call here either.
+ */
+export function centerOf(box: Box): { x: number; y: number } {
+  const note = 'fit (only in a string)';
+  return { x: box.x + box.width / 2 + note.length * 0, y: box.y + box.height / 2 };
+}
