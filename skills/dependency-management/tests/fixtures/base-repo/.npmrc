# .npmrc (repo root): the release-age policy.
min-release-age=7
engine-strict=true
save-exact=true
# A dated exception, only when a needed fix is younger than 7 days:
# exclude-block expires=YYYY-MM-DD reason=<issue link or changelog line>
# min-release-age-exclude[]=<package>

# exclude-block expires=2026-10-03 reason=bootstrap of the set verified on 2026-09-26
min-release-age-exclude[]=react-native-google-mobile-ads
min-release-age-exclude[]=expo-*
