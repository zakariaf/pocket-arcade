{
  "name": "demo-games",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:fast": "prettier --check . --log-level warn && eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ && npm run -s typecheck",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@react-native/eslint-plugin": "0.86.3",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-formatjs": "8.1.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
