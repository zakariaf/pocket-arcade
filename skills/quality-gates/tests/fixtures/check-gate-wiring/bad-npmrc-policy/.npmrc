# .npmrc (repo root): the three policy lines every gate expects. The dependency skill owns the rest
# of this file, including dated exception blocks.
# Refuse to resolve any version published less than 7 days ago.
min-release-age=7
# Refuse to install when node/npm do not satisfy package.json "engines".
engine-strict=true
# Never let npm guess ranges: every `npm install <pkg>` writes an exact version.

# A dated exception, only when a needed fix is younger than 7 days (expires = publish date + 7 days;
# verify fails once it has expired, and the whole block is then deleted, never extended):
# exclude-block expires=YYYY-MM-DD reason=<issue link or changelog line>
# min-release-age-exclude[]=<package>
