{
  "verified": "2026-09-30",
  "sdk": {
    "package": "expo-iap",
    "version": "5.8.0",
    "fallback": "5.6.3"
  },
  "adapter": {
    "file": "packages/shell/src/services/purchase/expo-iap-purchase-adapter.ts",
    "allowedImports": [
      "ErrorCode",
      "endConnection",
      "fetchProducts",
      "finishTransaction",
      "getAvailablePurchases",
      "initConnection",
      "purchaseErrorListener",
      "purchaseUpdatedListener",
      "requestPurchase",
      "restorePurchases",
      "Purchase",
      "PurchaseError",
      "Product"
    ],
    "mustContain": {
      "onlyIncludeActiveItemsIOS: false": "read Transaction.all (refunds stay visible) with getAvailablePurchases({ onlyIncludeActiveItemsIOS: false })",
      "isConsumable: false": "finish the non-consumable with finishTransaction({ purchase, isConsumable: false })"
    }
  },
  "bannedApis": [
    "kitApi",
    "KitApiError",
    "verifyPurchaseWithProvider",
    "verifyPurchase",
    "useIAP",
    "andDangerouslyFinishTransactionAutomatically"
  ],
  "bannedConfigWords": [
    "iapkitApiKey",
    "alternativeBilling",
    "enableLocalDev",
    "localPath",
    "onside",
    "EXPO_IAP_ONSIDE"
  ],
  "debugAction": {
    "name": "debug-premium-set",
    "allowedIn": [
      "packages/shell/src/stores/premium/",
      "packages/shell/src/app/test-only-entry.ts",
      "packages/shell/src/screens/debug/"
    ]
  },
  "productIdSuffix": ".premium",
  "familySharable": false,
  "familySharableDecidedBy": "owner 2026-09-30 (O3): Family Sharing stays off for Premium, never turned on",
  "price": {
    "targetEur": 1.99,
    "baseTerritory": "DEU",
    "decidedBy": "owner 2026-09-30 (O2): the EUR 1.99 App Store price point; the app always shows the store's localised price"
  },
  "storekit": {
    "template": "packages/tooling/src/storekit/Premium.storekit.template",
    "entitlements": "packages/tooling/src/storekit/storekit-harness.entitlements",
    "flowsDir": "packages/shell/e2e/storekit/",
    "allowedDir": "packages/tooling/src/storekit/",
    "relaunchFlows": ["02-refund-relaunch.yaml", "04-approval-relaunch.yaml"],
    "relaunchWaitMs": 60000,
    "relaunchWaitWhy": "A relaunch flow waits for the launch re-check (Transaction.all), which StoreKit answers only after storekitd has synced its transaction cache: on 2026-10-01 (iOS 26.5, Xcode 26.6) the query after testRefundAll took 28 s and a 15 s wait failed a correct app (the revocation arrived 2.6 s later)"
  },
  "catalogDir": "packages/shell/src/i18n/catalogs",
  "languages": [
    "en",
    "de",
    "fa",
    "ckb"
  ],
