{
  "permissions": {
    "deny": [
      "Read(~/.appstoreconnect/**)",
      "Read(**/*.p8)",
      "Read(**/AuthKey_*)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(~/.android-keys/**)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/play-service-account.json)"
    ]
  }
}
